# OpenPilot environment example.
# Copy this file to .env and replace blank secret values locally.

# Chat LLM settings for an OpenAI-compatible endpoint.
OPENPILOT_LLM_PROVIDER=openai-compatible
OPENPILOT_LLM_BASE_URL=https://api.openai.com/v1
OPENPILOT_LLM_API_KEY=
# Optional provider-scoped key used only by the Phase46D OpenAI experiment.
# Do not copy a DeepSeek key here; the readiness gate never reuses the active
# OPENPILOT_LLM_API_KEY for the OpenAI lane. The readiness runner reads this
# from the process environment; use `export` or explicitly source a local
# secret file before running it. Never commit a real value.
OPENPILOT_OPENAI_API_KEY=
OPENPILOT_LLM_MODEL=gpt-4o-mini
OPENPILOT_LLM_TIMEOUT_SECONDS=60
OPENPILOT_LLM_TEMPERATURE=0.2
OPENPILOT_LLM_TRANSPORT_RETRIES=2
OPENPILOT_LLM_RETRY_INITIAL_DELAY=2
OPENPILOT_LLM_RETRY_MAX_DELAY=20
# Optional typed capability-profile override. Leave blank for endpoint-based
# selection. Supported values are documented in API.md.
OPENPILOT_LLM_REASONING_CAPABILITY_PROFILE=
# Routine tool decisions accept provider_default or disabled. The default is
# disabled; ambiguous/general/multi-write decisions remain provider_default.
OPENPILOT_TOOL_EVENT_REASONING_MODE=disabled
# Exact pre-request context budgeting. DeepSeek uses its reviewed local
# tokenizer (install with `PYTHONPATH=src python -m core.token_counting
# --install-deepseek`); an explicit `openai-chat-known` profile resolves known
# OpenAI models through the installed `tiktoken` package. Unknown models remain
# fail-closed instead of using a character/token estimate.
OPENPILOT_LLM_TOKENIZER_PATH=
OPENPILOT_CONTEXT_MAX_PROMPT_TOKENS=4096
OPENPILOT_CONTEXT_RESERVED_PROMPT_TOKENS=128
# Provider-generated rolling summaries are a derived, non-authoritative view.
# Keep disabled until a provider lane has passed the offline and shadow gates.
OPENPILOT_ROLLING_SUMMARY_ENABLED=false
OPENPILOT_ROLLING_SUMMARY_TOKEN_LIMIT=256

# Provider-native execution is opt-in. Keep the bounded canary by default;
# use real_read_only only for an explicit non-mutating real-task experiment.
OPENPILOT_PROVIDER_TOOL_EXECUTION_ENABLED=false
OPENPILOT_PROVIDER_TOOL_EXECUTION_BUDGET_PROFILE=canary
OPENPILOT_PROVIDER_TOOL_EXECUTION_MAX_ROUNDS=3
# The segmented/compact initial-context projection remains off by default.
# Enable only for the read-only canary after its task/scopes are fixed.
OPENPILOT_PROVIDER_TOOL_INITIAL_CONTEXT_PROJECTION_ENABLED=false
# Mutation projection is a separate, higher-risk opt-in; keep it disabled.
OPENPILOT_PROVIDER_TOOL_INITIAL_CONTEXT_MUTATION_ENABLED=false
# Typed experiment-only feedback; keep off unless the selected arm enables it.
OPENPILOT_PROVIDER_TOOL_COMPLETION_OUTCOME_FEEDBACK_ENABLED=false

# Embedding settings.
# Leave the endpoint and key blank to inherit the LLM base URL and API key.
OPENPILOT_EMBEDDING_PROVIDER=openai-compatible
OPENPILOT_EMBEDDING_BASE_URL=
OPENPILOT_EMBEDDING_API_KEY=
OPENPILOT_EMBEDDING_MODEL=text-embedding-3-small
OPENPILOT_EMBEDDING_TIMEOUT_SECONDS=30

# Optional proxy settings used by network clients and web search diagnostics.
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=

# Runtime diagnostics / task trajectory evidence.
# Enabled by default. Set to 0/false/no/off to disable local evidence capture.
OPENPILOT_RUNTIME_DIAGNOSTICS_ENABLED=1
